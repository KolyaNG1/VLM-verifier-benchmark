# Локальные ключи и переменные окружения
.env
.env.*
!.env.example

# Виртуальные окружения и кэш Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Артефакты платных и пробных запусков VLM
runs/*
!runs/.gitkeep

# Локальный набор данных и его архивы: скачиваются или распаковываются отдельно.
data/
data.zip

# Временные материалы, в том числе извлечённые изображения.
tmp/

# Временные файлы системы документации
docs/.docs_ctl.lock
docs/.*.tmp
